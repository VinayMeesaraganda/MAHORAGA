# Mahoraga Environment Variables
# Copy this file to .dev.vars and fill in your values

# =============================================================================
# Alpaca Trading API (Required)
# Get your keys at: https://app.alpaca.markets/paper/dashboard/overview
# =============================================================================
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_API_SECRET=your_alpaca_api_secret_here

# IMPORTANT: Set to "true" for paper trading (recommended for testing)
# Set to "false" only when you're ready to trade with real money
ALPACA_PAPER=true

# =============================================================================
# API Authentication (Required)
# Generate a secure token with: openssl rand -base64 48
# =============================================================================
MAHORAGA_API_TOKEN=generate_a_secure_api_token_here

# =============================================================================
# LLM Provider Configuration
# Choose one of the three provider modes:
# =============================================================================

# Provider Mode (default: "openai-raw")
# - "openai-raw": Direct OpenAI API (simplest, uses OPENAI_API_KEY only)
# - "ai-sdk": Vercel AI SDK with multiple providers (OpenAI, Anthropic, Google, xAI, DeepSeek)
# - "cloudflare-gateway": Cloudflare AI Gateway (OpenAI-compatible /compat endpoint)
LLM_PROVIDER=openai-raw

# Model (format depends on provider mode)
# - openai-raw: "gpt-4o-mini", "gpt-4o", etc.
# - ai-sdk/cloudflare-gateway: "provider/model" e.g. "openai/gpt-4o", "anthropic/claude-sonnet-4"
LLM_MODEL=gpt-4o-mini

# --- Option 1: OpenAI Direct (openai-raw) ---
# Get your key at: https://platform.openai.com/api-keys
# Optional: override OpenAI API base URL (useful for OpenAI-compatible proxies)
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=sk-your_openai_api_key_here

# --- Option 1b: NVIDIA NIM, free developer tier (openai-raw + base URL) ---
# Key at https://build.nvidia.com — free account, no card, ~40 requests/minute.
# The endpoint is OpenAI-compatible, so keep LLM_PROVIDER=openai-raw.
# OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
# OPENAI_API_KEY=nvapi-your_nvidia_key_here
# NIM model ids are always publisher/model. Set them in agent-config.json as
# llm_model / llm_analyst_model, which is what the worker actually sends:
#   "llm_model": "nvidia/nemotron-3.5-lightning-30b-a3b"
# The publisher prefix is preserved whenever OPENAI_BASE_URL is set.
#
# Most current NIM models are reasoning models. They bill thinking against
# max_tokens and return it in a separate `reasoning_content` field, so a budget
# sized for the visible JSON alone yields empty content. Two options:
#   1. Leave the raised llm_research_max_tokens / llm_analyst_max_tokens
#      defaults in agent-config.json (2048 / 4096). Works everywhere.
#   2. Turn thinking off where the model supports it, e.g. NVIDIA Nemotron:
#      LLM_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}
# openai/gpt-oss-20b needs no extra body at all.
#
# LLM_EXTRA_BODY is a JSON object merged into every request body for any
# OpenAI-compatible endpoint. Core fields (model, messages, temperature,
# max_tokens, response_format) always take precedence.

# --- Option 2: AI SDK (ai-sdk) ---
# Set API keys for providers you want to use (at least one required)
# ANTHROPIC_API_KEY=sk-ant-your_anthropic_key_here
# GOOGLE_GENERATIVE_AI_API_KEY=your_google_ai_key_here
# XAI_API_KEY=xai-your_xai_key_here
# DEEPSEEK_API_KEY=sk-your_deepseek_key_here

# --- Option 3: Cloudflare AI Gateway (cloudflare-gateway) ---
# Configure your gateway in Cloudflare and use BYOK/Unified Billing with a gateway token.
# CLOUDFLARE_AI_GATEWAY_ACCOUNT_ID=your_cloudflare_account_id
# CLOUDFLARE_AI_GATEWAY_ID=your_gateway_id_or_name
# CLOUDFLARE_AI_GATEWAY_TOKEN=your_cloudflare_ai_gateway_token

# =============================================================================
# Twitter/X API (Optional - for signal confirmation)
# Get your bearer token at: https://developer.x.com/
# =============================================================================
# NOTE: Twitter API costs ~$0.005-0.01 per read. The agent is configured to 
# use max 200 reads/day (~$1-2/day) and only for confirming high-quality signals.
# Leave blank to disable Twitter integration.
# --- Reddit (application-only OAuth) ---
# The public www.reddit.com JSON endpoints return 403 from datacenter IPs.
# Create a script app at https://www.reddit.com/prefs/apps
#   type:         script
#   redirect uri: http://localhost:8787/reddit-callback  (required by the form, never called)
# Then copy the client id (under the app name) and the secret.
# This uses the client_credentials grant: no Reddit account password is involved.
# Raises the limit from ~10 to ~100 queries/minute.
# REDDIT_CLIENT_ID=your_reddit_client_id
# REDDIT_CLIENT_SECRET=your_reddit_client_secret

TWITTER_BEARER_TOKEN=

# =============================================================================
# Discord Notifications (Optional)
# =============================================================================
DISCORD_WEBHOOK_URL=

# =============================================================================
# Security
# =============================================================================
# Emergency kill switch secret (separate from API token)
# Generate with: openssl rand -base64 48
KILL_SWITCH_SECRET=generate_a_random_string_here
